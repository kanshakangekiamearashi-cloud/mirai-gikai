#--- Common ---
# npx supabase statusで確認できる情報を設定してください（Vercel公開時は Supabase クラウドプロジェクトの値を設定）
SUPABASE_URL=http://127.0.0.1:54421
# `npx supabase status` の "Secret" を設定してください（サーバー側専用。NEXT_PUBLIC_ には絶対に入れないこと）
SUPABASE_SECRET_KEY=
# Supabase プロジェクトのURL（公開してよい値）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# `npx supabase status` の "Publishable" を設定してください（公開してよい値）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web側のキャッシュを無効化するためのシークレットキー（未設定だと /api/revalidate が 500 を返し安全側に倒れる。web と admin で同じ値を設定すること）
REVALIDATE_SECRET=
# Vercel AI GatewayのAPIキーを設定してください（インタビュー等の Gateway 経由モデル用。未設定でも閲覧系ページと公開チャットは動作する）
AI_GATEWAY_API_KEY=
# Google AI StudioのAPIキーを設定してください（公開チャットが Gemini 無料枠で使用。未設定だと公開チャットだけがエラーになる）
GOOGLE_GENERATIVE_AI_API_KEY=
# AdminサーバーのURL（web/admin両方で使用）
ADMIN_URL=http://localhost:3001

#--- Web ---
# Basic認証をONにする場合は設定してください（片方だけ設定しても有効にならない。未設定の間は無認証で公開される点に注意）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Langfuse設定（プロンプト管理・LLM監視）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Langfuseのプロンプト取得ラベル
LANGFUSE_PROMPT_LABEL=
# AI Chatの日次コストリミット（USD）- ユーザー単位（旧名 CHAT_DAILY_COST_LIMIT_USD もフォールバックとして有効）
CHAT_DAILY_USER_COST_LIMIT_USD=
# AI Chatの日次コストリミット（USD）- システム全体
CHAT_DAILY_TOTAL_COST_LIMIT_USD=
# AI Chatの月間コストリミット（USD）- システム全体
CHAT_MONTHLY_TOTAL_COST_LIMIT_USD=
# Google Analytics の測定ID
NEXT_PUBLIC_GA_TRACKING_ID=
# 記事レポートのSlack通知先 Webhook URL
ARTICLE_REPORT_SLACK_WEBHOOK_URL=
# オープンデータAPIのレート制限
OPEN_DATA_RATE_LIMIT_PER_IP=
OPEN_DATA_RATE_LIMIT_GLOBAL=

# --- Admin ---
# WebサーバーのURLを設定してください
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# MCPサーバー（/api/mcp）へのBearer認証トークン。mirai-gikai-content のエージェント等から接続するときに使用する。
ADMIN_MCP_TOKEN=
# トピック分析を Cloud Run で実行する場合のみ
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GCP_TOPIC_ANALYSIS_JOB=
# サービスアカウント鍵JSONを丸ごと文字列として設定する
GCP_SA_KEY=

# --- Supabase Auth (Google OAuth) ---
# Google OAuth用の設定（本番・staging環境で必要）
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# OAuthコールバックURL（config.tomlのadditional_redirect_urlsで参照、ADMIN_URL + /api/auth/callback）
ADMIN_AUTH_CALLBACK_URL=http://localhost:3001/api/auth/callback
